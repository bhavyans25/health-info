# PostgreSQL Database URL for Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/instaclone?schema=public"

# Redis URL for sessions & rate-limiting
REDIS_URL="redis://localhost:6379"

# JWT Secret for access token signature
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Port for Socket.IO realtime server
PORT=4000

# Next.js Frontend URL (for Socket.IO CORS configuration)
FRONTEND_URL="http://localhost:3000"
