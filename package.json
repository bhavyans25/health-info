{
  "name": "instaclone-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for InstaClone",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "postinstall": "npm run prisma:generate --workspace=@instaclone/db --if-present"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
